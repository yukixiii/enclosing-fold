{
  "name": "enclosing-fold",
  "version": "0.3.0",
  "description": "Fold the heading or list section around the cursor, even when the cursor is inside it.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": ["obsidian", "plugin", "fold", "vim"],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
